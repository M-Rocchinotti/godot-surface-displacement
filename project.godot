; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GADS Demo"
config/description="Demo and test project for the GADS addon: parallax occlusion mapping, near-camera displaced ground geometry and pebble scatter for Godot 4.7 (Forward+)."
config/version="0.2.0"
run/main_scene="res://demo/demo_main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/gads/plugin.cfg")

[shader_globals]

gads_pom_steps={
"type": "vec4",
"value": Vector4(8, 20, 3, 0)
}
gads_pom_range={
"type": "vec4",
"value": Vector4(18, 30, 0, 6)
}
gads_shadow={
"type": "vec4",
"value": Vector4(6, 15, 0, 1)
}
gads_debug={
"type": "vec4",
"value": Vector4(0, 0.1, 0, 0)
}
gads_dfg={
"type": "sampler2D",
"value": "res://addons/gads/render/textures/gads_dfg_lut.exr"
}
